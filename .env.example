# Optional Azure Custom Vision provider. Keep real values in .env.local only.
AZURE_CUSTOM_VISION_PREDICTION_URL=https://<resource>.cognitiveservices.azure.com/customvision/v3.0/Prediction/<project-id>/classify/iterations/<published-name>/image
AZURE_CUSTOM_VISION_PREDICTION_KEY=<prediction-key>

# Optional local service overrides.
# VISION_DOCKER_URL=http://127.0.0.1:8080/image
# AGENT_SERVICE_URL=http://127.0.0.1:8000/investigate
